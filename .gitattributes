# Text files are checked out ending lines with LF on every platform, as
# the tests read fixtures by their lines and byte for byte.
* text=auto eol=lf

# What a Composer package leaves out: the repository's own development
# files. LICENSE, README.md, composer.json and src/ are what it ships.
/.githooks export-ignore
/.github export-ignore
/artwork export-ignore
/doc export-ignore
/tests export-ignore
/tools export-ignore
/.gitattributes export-ignore
/.gitignore export-ignore
/.php-cs-fixer.dist.php export-ignore
/phpstan.neon.dist export-ignore
/phpunit.xml.dist export-ignore
/composer.lock export-ignore
/AGENTS.md export-ignore
/CLAUDE.md export-ignore
/CONFORMANCE.md export-ignore
/CONTRIBUTING.md export-ignore
/RULES.md export-ignore
/TODO.md export-ignore
